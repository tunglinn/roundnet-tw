{
  "name": "roundnet-tw",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev --persist-to ../wrangler-state",
    "db": "wrangler d1 execute roundnet-tw --local --persist-to ../wrangler-state --command",
    "db:init": "wrangler d1 execute roundnet-tw --local --persist-to ../wrangler-state --file worker/schema.sql",
    "db:init:remote": "wrangler d1 execute roundnet-tw --remote --file worker/schema.sql",
    "deploy": "wrangler pages deploy",
    "test": "vitest run",
    "vapid": "node scripts/vapid-keys.js"
  },
  "devDependencies": {
    "vitest": "^2.1.9",
    "wrangler": "^4.149.0"
  }
}
